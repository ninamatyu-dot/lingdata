        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2109" ANNOTATION_REF="a2108">
                <ANNOTATION_VALUE>помощь в реализации мыслей, ударения на словах, голова: подтверждение собственных слов</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2113" ANNOTATION_REF="a2112">
                <ANNOTATION_VALUE>изображает какие-то блюда</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2116" ANNOTATION_REF="a2115">
                <ANNOTATION_VALUE>голова: соглашается сама с собой, параллельно поправляет свитер (не несет особого смысла)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2121" ANNOTATION_REF="a2120">
                <ANNOTATION_VALUE>задумчивость</ANNOTATION_VALUE>
