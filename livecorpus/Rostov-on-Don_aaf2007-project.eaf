        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2136" ANNOTATION_REF="a2135">
                <ANNOTATION_VALUE>покачивание головой в такт словам выражает задумчивость и волнение </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2128" ANNOTATION_REF="a2127">
                <ANNOTATION_VALUE>акцент на том, что ей разрешали готовить</ANNOTATION_VALUE>
